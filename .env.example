# ============================================================
# WealthSeva AI — Environment Variables
# Copy to .env (backend) and .env.local (frontend)
# NEVER commit the actual .env files to git
# ============================================================

# Amazon Bedrock / Claude (via AWS)
# Compute runs in ap-south-1 (Mumbai), API origin is AWS Bedrock (not Anthropic direct)
# Authentication via IAM role (no API key needed when running on EC2/Lambda)
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-20250514-v1:0

# ElevenLabs (Avatar voices)
# Note: ElevenLabs API origin may be outside India — ensure this complies with
# IDBI's data residency requirements for audio processing
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_EN=your_english_voice_id
ELEVENLABS_VOICE_HI=your_hindi_voice_id
ELEVENLABS_VOICE_MR=your_marathi_voice_id
ELEVENLABS_VOICE_TA=your_tamil_voice_id
ELEVENLABS_VOICE_BN=your_bengali_voice_id

# Supabase
# Note: Supabase may host data outside India — ensure this complies with
# IDBI's data residency requirements for user data storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Pinecone (Vector DB)
# Note: Pinecone hosts vector indices outside India — ensure this complies with
# IDBI's data residency requirements for RAG context storage
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENV=your_pinecone_environment
PINECONE_INDEX=wealthseva-idbi

# IDBI Sandbox APIs (provided at orientation / after shortlist)
IDBI_SANDBOX_BASE_URL=https://sandbox.idbi.com/api
IDBI_SANDBOX_API_KEY=your_idbi_sandbox_key
IDBI_CLIENT_ID=your_idbi_client_id
IDBI_CLIENT_SECRET=your_idbi_client_secret

# AWS (provided by IDBI Bank)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=wealthseva-ai-assets

# App Config
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi,mr,ta,bn

# Frontend (Next.js client-side — must be prefixed with NEXT_PUBLIC_)
# Copy these into frontend/.env.local
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
