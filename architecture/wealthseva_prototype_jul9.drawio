        <mxCell id="t_foot1" value="Deliberate design: no API Gateway / VPC / ALB — the Function URL is the sole ingress, secured at the app layer." style="text;html=1;fontSize=10;fontColor=#545B64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="870" width="640" height="16" as="geometry"/></mxCell>
