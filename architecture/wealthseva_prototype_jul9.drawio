        <mxCell id="n_furl_t" value="&lt;b&gt;Lambda Function URL — sole ingress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;AuthType NONE — public, app-gated&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;InvokeMode RESPONSE_STREAM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;chat gate: 10 req/min per IP · 2000-char cap&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;kill-switch CHAT_PUBLIC_ENABLED · CORS&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="345" width="254" height="76" as="geometry"/></mxCell>
