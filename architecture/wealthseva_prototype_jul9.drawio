        <mxCell id="n_amplify_t" value="&lt;b&gt;AWS Amplify Hosting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;branch main · auto-deploy on push&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;main.d13rdix674q29k.amplifyapp.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;Next.js 14 SSR · App Router · next-intl&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;Amplify-managed HTTPS + CDN (CloudFront)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;SSR proxy app/api/[...path]/route.ts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;→ injects x-origin-verify (server-side)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="162" y="345" width="244" height="120" as="geometry"/></mxCell>
